# Modelo do .env de produção (D78). Sem segredos: os valores reais ficam só
# no painel do Ploi ("Environment" do site). Gere a APP_KEY no servidor com
# `php artisan key:generate --show`.

APP_NAME="he4rt ink"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Endereço público com https: o worker monta os links dos e-mails com ele (D71)
APP_URL=https://

# Só se o domínio passar pelo proxy do Cloudflare (DEPLOY.md, passo 4)
# TRUSTED_PROXIES=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MariaDB no próprio servidor, criado pelo Ploi; acesso só pela aplicação (p8-03)
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=20160
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Imagens no bucket privado do Cloudflare R2 (D53)
MEDIA_DISK=r2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<id-da-conta>.r2.cloudflarestorage.com

# E-mail: o provedor ainda não foi escolhido (p8-01, D71). Os valores entram
# quando a comparação for feita; até lá, nenhum e-mail sai em produção.
MAIL_MAILER=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Contatos das políticas (D73)
PRIVACY_EMAIL=privacidade@he4rt.ink
CONTACT_EMAIL=contato@he4rt.ink

VITE_APP_NAME="${APP_NAME}"
